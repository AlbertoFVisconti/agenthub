{
  "name": "@agenthub/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env DEPLOYMENT_MODE=cloud tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@agenthub/tool-utils": "file:../../../packages/tool-utils/agenthub-tool-utils-1.0.0.tgz",
    "@agenthub/types": "file:../../../packages/types/agenthub-types-0.0.1.tgz",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "adm-zip": "^0.6.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.6.0",
    "pg": "^8.11.0",
    "pino-pretty": "^11.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "@agenthub/tool-sdk": "file:../../../packages/tool-sdk/agenthub-tool-sdk-1.0.0.tgz"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^8.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.22.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}