{
  "name": "@agenthub-tools/desktop",
  "version": "0.0.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.6.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.agenthub.desktop",
    "productName": "AgentHub",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "build_stage/api",
        "to": "api",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web/out",
        "to": "web/out",
        "filter": [
          "**/*"
        ]
      }
    ],
    "compression": "normal"
  },
  "description": "AgentHub Desktop App",
  "author": "AgentHub"
}