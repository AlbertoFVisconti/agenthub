# ─────────────────────────────────────────────────────────────
# AgentHub — Environment Variables
# Copy this file to .env (gitignored) and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────
# Local Docker Compose (default):
DATABASE_URL=postgresql://agenthub:agenthub@localhost:5432/agenthub
# Cloud (e.g. Neon, Supabase) — uncomment and replace when ready:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require

# ── Session / JWT ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_hex_chars_random_string

# ── API Key Encryption ───────────────────────────────────────
# AES-256-GCM key (must be exactly 32 bytes → 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_KEY=replace_with_64_hex_chars_random_string

# ── GitHub OAuth (Phase 5.5) ─────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback

# ── API Server ───────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Docker (Phase 7) ─────────────────────────────────────────
# Docker socket path (host-only; never exposed to tool containers)
DOCKER_SOCKET=/var/run/docker.sock
# Default resource limits for tool containers
TOOL_CONTAINER_MEMORY=256m
TOOL_CONTAINER_CPUS=0.5
TOOL_CONTAINER_TIMEOUT_SECONDS=30
